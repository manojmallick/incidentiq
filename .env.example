# IncidentIQ — environment template. Copy to .env and fill in. NEVER commit .env.

# --- Google Cloud / Gemini 3 (REQUIRED by hackathon rules) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3
EMBEDDING_MODEL=text-embedding-004

# --- Elasticsearch (partner) ---
# The app spawns the official Elastic MCP server (@elastic/mcp-server-elasticsearch) with
# these as ES_URL / ES_API_KEY and routes precedent search through its `search` tool.
ELASTIC_URL=https://your-deployment.es.europe-west1.gcp.cloud.es.io
ELASTIC_API_KEY=base64apikey==
ELASTIC_INCIDENTS_INDEX=ict-incidents

# --- Google Cloud Agent Builder (Vertex AI Agent Engine) — runtime invocation ---
# Set AGENT_ENGINE_ID to a deployed reasoningEngine (see agent-builder/deploy.py). When set,
# /api/classify routes the explain + DNB-draft step through the deployed ADK agent
# (Gemini 3 + Elastic MCP). Leave blank to use the direct Gemini path. Needs ADC:
#   gcloud auth application-default login
# AGENT_ENGINE_ID=projects/PROJECT/locations/us-central1/reasoningEngines/1234567890
# AGENT_ENGINE_USER=incidentiq-app

# --- App ---
PORT=8080
NODE_ENV=development

# --- Demo mode: set MOCK=true to run the full UI + ApprovalBar flow with
# canned data and NO credentials (great for rehearsing the ~3-min demo). ---
# MOCK=true
